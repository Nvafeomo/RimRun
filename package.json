{
  "name": "rimrun",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "import-courts": "node scripts/import-courts.js",
    "import-courts:upsert": "node scripts/import-courts.js --upsert",
    "geocode-courts": "node scripts/geocode-courts.js",
    "prune-indoor-courts": "node scripts/prune-indoor-courts.js",
    "prune-indoor-courts:execute": "node scripts/prune-indoor-courts.js --execute",
    "prune-indoor-courts:overpass": "node scripts/prune-indoor-courts.js --overpass",
    "prune-indoor-courts:overpass:execute": "node scripts/prune-indoor-courts.js --overpass --execute",
    "sync-privacy-policy": "node scripts/sync-privacy-policy.js",
    "generate-feature-graphic": "node scripts/generate-feature-graphic.js",
    "eas:init": "eas init",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:production:ios": "eas build --platform ios --profile production",
    "build:production:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "submit:android": "eas submit --platform android --profile production --latest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.117.2",
    "babel-preset-expo": "^58.0.9",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.3",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~58.0.8",
    "expo-build-properties": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~58.0.12",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~58.0.10",
    "expo-location": "~57.0.20",
    "expo-router": "~58.0.13",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-maps": "1.29.11",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.28.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "dotenv": "^16.6.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true,
